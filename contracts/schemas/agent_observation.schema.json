{
  "$defs": {
    "DiplomaticMessage": {
      "description": "Natural-language communication between civilizations.",
      "properties": {
        "message_id": {
          "description": "Unique message ID",
          "title": "Message Id",
          "type": "string"
        },
        "turn": {
          "description": "Simulation turn when sent",
          "title": "Turn",
          "type": "integer"
        },
        "sender_id": {
          "description": "Sending nation ID",
          "title": "Sender Id",
          "type": "string"
        },
        "recipient_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target nation ID, or None if public announcement",
          "title": "Recipient Id"
        },
        "is_private": {
          "default": false,
          "description": "True if private 1-on-1 message",
          "title": "Is Private",
          "type": "boolean"
        },
        "content": {
          "description": "Natural-language message body",
          "title": "Content",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO timestamp",
          "title": "Timestamp"
        }
      },
      "required": [
        "message_id",
        "turn",
        "sender_id",
        "content"
      ],
      "title": "DiplomaticMessage",
      "type": "object"
    },
    "Nation": {
      "description": "Represents an autonomous AI civilization.",
      "properties": {
        "id": {
          "description": "Unique nation ID, e.g. nation_1",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Civilization name, e.g. Solaria",
          "title": "Name",
          "type": "string"
        },
        "color": {
          "description": "Hex color code for map rendering, e.g. #3B82F6",
          "title": "Color",
          "type": "string"
        },
        "leader_name": {
          "description": "AI leader persona name",
          "title": "Leader Name",
          "type": "string"
        },
        "personality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Starting archetype, e.g. Opportunist, Altruist, Skeptic",
          "title": "Personality"
        },
        "gold": {
          "default": 100,
          "description": "Current treasury",
          "title": "Gold",
          "type": "integer"
        },
        "food": {
          "default": 60,
          "description": "Current food stock",
          "title": "Food",
          "type": "integer"
        },
        "military_units": {
          "default": 12,
          "description": "Total active military units across all territories",
          "title": "Military Units",
          "type": "integer"
        },
        "territory_ids": {
          "description": "IDs of owned territories",
          "items": {
            "type": "string"
          },
          "title": "Territory Ids",
          "type": "array"
        },
        "current_goals": {
          "description": "Active high-level goals",
          "items": {
            "type": "string"
          },
          "title": "Current Goals",
          "type": "array"
        },
        "is_alive": {
          "default": true,
          "description": "False if conquered",
          "title": "Is Alive",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "leader_name"
      ],
      "title": "Nation",
      "type": "object"
    },
    "Territory": {
      "description": "Represents a discrete region on the Risk-style map.",
      "properties": {
        "id": {
          "description": "Unique territory ID, e.g. T01",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable territory name",
          "title": "Name",
          "type": "string"
        },
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nation ID owning this territory, None if neutral",
          "title": "Owner Id"
        },
        "gold_production": {
          "default": 5,
          "description": "Gold produced per turn",
          "title": "Gold Production",
          "type": "integer"
        },
        "food_production": {
          "default": 4,
          "description": "Food produced per turn",
          "title": "Food Production",
          "type": "integer"
        },
        "stationed_military": {
          "default": 0,
          "description": "Military units stationed here",
          "title": "Stationed Military",
          "type": "integer"
        },
        "adjacent_territory_ids": {
          "description": "List of adjacent territory IDs",
          "items": {
            "type": "string"
          },
          "title": "Adjacent Territory Ids",
          "type": "array"
        },
        "coord_x": {
          "default": 0.0,
          "description": "2D map layout X coordinate (0-100 scale)",
          "title": "Coord X",
          "type": "number"
        },
        "coord_y": {
          "default": 0.0,
          "description": "2D map layout Y coordinate (0-100 scale)",
          "title": "Coord Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Territory",
      "type": "object"
    }
  },
  "description": "Sanitized, permission-filtered world observation sent to an AI agent.",
  "properties": {
    "turn": {
      "title": "Turn",
      "type": "integer"
    },
    "nation": {
      "$ref": "#/$defs/Nation"
    },
    "known_territories": {
      "items": {
        "$ref": "#/$defs/Territory"
      },
      "title": "Known Territories",
      "type": "array"
    },
    "current_goals": {
      "items": {
        "type": "string"
      },
      "title": "Current Goals",
      "type": "array"
    },
    "recent_events": {
      "items": {
        "type": "string"
      },
      "title": "Recent Events",
      "type": "array"
    },
    "relationships": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Relationships",
      "type": "object"
    },
    "visible_messages": {
      "items": {
        "$ref": "#/$defs/DiplomaticMessage"
      },
      "title": "Visible Messages",
      "type": "array"
    },
    "available_actions": {
      "items": {
        "type": "string"
      },
      "title": "Available Actions",
      "type": "array"
    }
  },
  "required": [
    "turn",
    "nation",
    "known_territories",
    "current_goals",
    "recent_events",
    "relationships",
    "visible_messages",
    "available_actions"
  ],
  "title": "AgentObservation",
  "type": "object"
}