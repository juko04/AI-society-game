      "type": "string"
    },
    "nation_id": {
      "description": "Nation executing the action",
      "title": "Nation Id",
      "type": "string"
    },
    "action_type": {
      "description": "Type of action",
      "enum": [
        "claim",
        "recruit",
        "develop",
        "move",
        "attack",
        "transfer",
        "trade",
        "alliance",
        "pass"
      ],
      "title": "Action Type",
      "type": "string"
    },
    "target_territory_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
