      "title": "Units Count"
    },
    "gold_amount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Gold involved in transfer or trade",
      "title": "Gold Amount"
    },
    "food_amount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
