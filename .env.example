# ==========================================
# Emergent Nations - Environment Config
# Copy this file to .env or backend/.env
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence
DATABASE_URL=sqlite:///./simulations.db

# AI & Model Configuration
# When USE_MOCK_AGENTS=true, the simulation runs deterministic scripted AI agents (no Ollama required).
USE_MOCK_AGENTS=true
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_MODEL=qwen3:8b
ALTERNATIVE_AI_MODEL=qwen3:4b

# Simulation Defaults
SIMULATION_SEED=42
TOTAL_TERRITORIES=36
TOTAL_NATIONS=6

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api
